{
  "name": "vibemotion",
  "version": "0.2.1",
  "description": "Embedded motion tuning SDK — framework-agnostic Web Components for real-time animation editing",
  "license": "MIT",
  "author": "Joseph Deng",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/dwf89044485/vibeset.git"
  },
  "keywords": [
    "motion",
    "animation",
    "tuner",
    "web-components",
    "design-tool",
    "vibeset"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/bindings/react.d.ts",
      "import": "./dist/bindings/react.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "cd examples/basic && python3 -m http.server 3000"
  },
  "dependencies": {
    "lit": "^3.2.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
