{
  "name": "vibeset-core",
  "version": "0.1.0",
  "description": "Core logic for Vibeset — types, registry, store, state machine, measurement, export",
  "license": "MIT",
  "author": "Joseph Deng",
  "repository": {
    "type": "git",
    "url": "https://github.com/dwf89044485/vibeset.git",
    "directory": "packages/core"
  },
  "keywords": [
    "motion",
    "animation",
    "tuner",
    "sdk",
    "design-tool"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}