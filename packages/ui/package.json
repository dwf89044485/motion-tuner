{
  "name": "vibeset-ui",
  "version": "0.1.0",
  "description": "UI components for Vibeset — slider, xy-pad, motion panel, overlay, launcher",
  "license": "MIT",
  "author": "Joseph Deng",
  "repository": {
    "type": "git",
    "url": "https://github.com/dwf89044485/vibeset.git",
    "directory": "packages/ui"
  },
  "keywords": [
    "motion",
    "animation",
    "tuner",
    "ui",
    "design-tool",
    "slider"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "vibeset-core": "^0.1.0",
    "vibeset-react": "^0.1.0",
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^24.0.0",
    "vibeset-core": "workspace:*",
    "vibeset-react": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}